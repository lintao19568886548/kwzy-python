# Local development only — never commit real secrets
# Allowed APP_ENV: local | test | staging | production (case-insensitive)
APP_ENV=local
DEBUG=true
DATABASE_URL=sqlite+pysqlite:///./kwzy_step1.db
# Applied to PostgreSQL/MySQL engines; SQLite ignores these values.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
JWT_SECRET=change-me-in-production
CORS_ORIGINS=*
TRUSTED_HOSTS=*
# Required to create local admin on first boot (leave empty to skip admin seed)
LOCAL_ADMIN_PASSWORD=
# Explicit local/test-only seed. Run `alembic upgrade head` first.
BOOTSTRAP_LOCAL_IDENTITY=false
# Explicit opt-in for anonymous local/test identity (default false / fail-closed)
ALLOW_ANON_DEV=false
