# Local development only — never commit real secrets
# Allowed APP_ENV: local | test | staging | production (case-insensitive)
APP_ENV=local
DEBUG=true
DATABASE_URL=sqlite+pysqlite:///./kwzy_step1.db
JWT_SECRET=change-me-in-production
CORS_ORIGINS=*
# Required to create local admin on first boot (leave empty to skip admin seed)
LOCAL_ADMIN_PASSWORD=
# Explicit opt-in for anonymous local/test identity (default false / fail-closed)
ALLOW_ANON_DEV=false
