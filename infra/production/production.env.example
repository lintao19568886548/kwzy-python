# Copy to a secret-managed deployment environment. Never commit populated values.
KWZY_API_IMAGE=registry.example.invalid/kwzy-api:<immutable-sha>
KWZY_WEB_IMAGE=registry.example.invalid/kwzy-web:<immutable-sha>
KWZY_BIND_HOST=127.0.0.1
KWZY_WEB_PORT=8080
DATABASE_URL=postgresql+psycopg://<user>:<password>@<pg16-host>:5432/<database>
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
JWT_SECRET=<secret-manager-reference-at-least-32-bytes>
CORS_ORIGINS=https://<public-host>
TRUSTED_HOSTS=<public-host>
SMS_API_KEY=<secret-manager-reference>
SMS_ENDPOINT=https://<provider-endpoint>
WECHAT_APP_ID=<secret-manager-reference>
WECHAT_APP_SECRET=<secret-manager-reference>
OSS_ENDPOINT=https://<object-storage-endpoint>
OSS_BUCKET=<bucket>
OSS_ACCESS_KEY=<secret-manager-reference>
OSS_SECRET_KEY=<secret-manager-reference>
